{
  "name": "nextjs-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:finance & npm run dev:bible",
    "dev:finance": "npm run dev -w pj_finance",
    "dev:bible": "npm run dev -w pj_bible",
    "build": "npm run build -ws --if-present",
    "build:finance": "npm run build -w pj_finance",
    "build:bible": "npm run build -w pj_bible",
    "lint": "npm run lint -ws --if-present",
    "clean": "npm run clean -ws --if-present; rm -rf node_modules"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "pnpm": "^10.30.1"
  }
}

# 复制为本目录下的 .env.local 后填入；勿将含真实密钥的文件提交仓库。
# cp .env.example .env.local

# 词典 LLM：nvidia / openai / ollama（空则根据是否配置各厂商 Key 自动推断；勿在等号两边或行尾多加空格）
# 修改本文件对应的 .env.local 后须重启 next dev，否则仍为旧进程环境变量。
WORD_LOOKUP_PROVIDER=

# NVIDIA NIM：文档为 https://integrate.api.nvidia.com + POST /v1/chat/completions
# 可填 https://integrate.api.nvidia.com/v1 或仅 https://integrate.api.nvidia.com（代码会自动补 /v1）
NVIDIA_CHAT_BASE_URL=
# NVIDIA API Key（仅服务端可读，勿使用 NEXT_PUBLIC_ 前缀）
NVIDIA_API_KEY=
# NVIDIA 控制台中模型的完整 ID（须与 LLM APIs 文档一致且账号已启用；错误或空字符串时远端会返回 404）
NVIDIA_CHAT_MODEL=

# OpenAI 兼容调用（可与上方二选一）
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# 本地 Ollama
OLLAMA_BASE_URL=
OLLAMA_MODEL=

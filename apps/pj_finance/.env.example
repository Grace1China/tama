# 仅作模板；Next 实际只加载 pj_finance 目录下的 .env.local（本文件改完不会生效）。
# 请在本目录新建或编辑 .env.local，填入下方变量后重启 dev。勿提交 .env.local。

# 热点归纳：显式使用本地 OpenAI 兼容接口（与 auto 优先本地一致，二选一即可）
HOT_CONCEPTS_LLM=local
# LLM 超时（毫秒）。不设时：本地默认 600000，云端默认 180000；极慢本机可设更大，上限约 3600000。
# HOT_CONCEPTS_LLM_TIMEOUT_MS=1200000

# 本地 LLM 时若仅报 fetch failed，多半是系统/终端代理：Node fetch 会走 HTTP(S)_PROXY，可对本机绕过
# NO_PROXY=127.0.0.1,localhost

# 本地 LLM（LM Studio / Ollama 等，需能访问 /v1/chat/completions）
LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_MODEL=gemma4
# LOCAL_LLM_API_KEY=

# 若 HOT_CONCEPTS_LLM=deepseek 或 auto 且未配置 LOCAL_LLM_BASE_URL，则使用 DeepSeek
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
